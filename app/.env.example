# ── Database ────────────────────────────────────────────────────────────────
# Neon connection strings. Get from https://console.neon.tech/ → Project →
# Connection Details. Pooled URL is the default; unpooled is used by
# drizzle-kit migrations and any long-lived script.
DATABASE_URL="postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=""
# Canonical app URL. Use http://localhost:3210 for local dev; the production
# URL on Vercel.
AUTH_URL="http://localhost:3210"

# ── Google OAuth (REQUIREMENTS §11) ─────────────────────────────────────────
# Create at https://console.cloud.google.com/ → APIs & Services →
# Credentials → OAuth 2.0 Client ID. Authorized redirect URIs must include
# {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email magic-link (REQUIREMENTS §11) ─────────────────────────────────────
# SMTP relay. Local dev: any inbox-catcher (Mailpit, MailHog, Mailcatcher).
# Production: provider chosen at Phase 8 (frontrunner: Resend SMTP).
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="Wander <noreply@example.com>"

# Geoapify (place search, place details, OG static map). Server-only — never
# prefix with NEXT_PUBLIC_. Free plan: 3,000 credits/day, no card. Without it,
# search falls back to Photon and the OG image renders without a map.
GEOAPIFY_API_KEY=""

# Canonical public origin, used as Next's `metadataBase` so OG image URLs are
# absolute. Optional on Vercel (VERCEL_PROJECT_PRODUCTION_URL is used instead);
# local dev falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=""

# ── Feature flags (lib/feature-flags.ts) ────────────────────────────────────
# Server-only. Read once at module load; restart server after change.
# Accepted truthy values: true, 1, yes, on (case-insensitive). Anything else
# (including unset/empty) = false.

# Auth bypass. ON → skip Google OAuth; auto sign-in as a fixed dev user
# (id 00000000-0000-0000-0000-0000000d3000, email dev-bypass@local). Dev
# user row is upserted on first request.
# NEVER set ON in production — it returns a valid session for any caller.
# Default: OFF.
AUTH_BYPASS="false"

# Invite-only registration (TP-0031, docs/plans/invite-only-access.md).
# ON → only an address that already has an account, sits in ACCESS_ALLOWLIST,
# or holds a pending trip invite may complete sign-in. Everyone else lands on
# /sign-in/not-invited before any user row is created and before any magic
# link is sent. Existing users are unaffected.
# Default: OFF. Before turning it ON in production, check that no live user
# row has a null email: select count(*) from "user" where email is null;
INVITE_ONLY="false"

# Comma-separated addresses allowed to register while INVITE_ONLY is ON.
# Adding an address here IS the invite (lowercased/trimmed on read).
ACCESS_ALLOWLIST=""

# Where the "request access" link on /sign-in/not-invited points.
# Falls back to EMAIL_FROM when unset.
ACCESS_REQUEST_EMAIL=""

# ── Anonymous rate limiting (TP-0031) ───────────────────────────────────────
# Salt mixed into the hashed client IP before it is stored as a rate_limit
# key, so Postgres never holds a raw-IP log. Any random string; changing it
# resets every in-flight window.
RATE_LIMIT_IP_SALT=""

# Per-IP budgets. Defaults shown; each is a positive integer or it is ignored.
# signin = both /sign-in server actions + direct POSTs to /api/auth/signin.
# join   = anonymous /invite/[token] loads. anon = the public landing page.
ANON_RATE_LIMIT_SIGNIN_MAX="10"
ANON_RATE_LIMIT_SIGNIN_WINDOW_SECONDS="600"
ANON_RATE_LIMIT_JOIN_MAX="30"
ANON_RATE_LIMIT_JOIN_WINDOW_SECONDS="600"
ANON_RATE_LIMIT_ANON_MAX="120"
ANON_RATE_LIMIT_ANON_WINDOW_SECONDS="600"

# Shared secret for the Vercel cron that prunes stale rate_limit rows
# (/api/internal/prune-rate-limit). Unset → the route refuses every request.
CRON_SECRET=""
